#!/usr/bin/env python3
"""Конвейер opencode (реализация) -> Claude (ревью) -> opencode (ответ на ревью) -> проверка.

    dual-loop run "задача"            полный цикл
    dual-loop run -f task.md          задача из файла
    dual-loop run --skip-impl         реализация уже в рабочем дереве, начать с ревью

Один запуск = одна сессия opencode: ответ на ревью идёт в тот же контекст, где
писался код. Результаты каждого шага лежат в .dual-loop/<время>/.
"""
import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
import time
from pathlib import Path

ROOT = Path(subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip())
RUNS = ROOT / ".dual-loop"

IMPL_MODEL = os.environ.get("DUAL_IMPL_MODEL", "opencode-go/deepseek-v4.1-flash")
REVIEW_MODEL = os.environ.get("DUAL_REVIEW_MODEL", "claude-sonnet-5-5")
CHECK_CMD = os.environ.get("DUAL_CHECK_CMD", "make lint && make test")
REVIEW_BUDGET_USD = os.environ.get("DUAL_REVIEW_BUDGET_USD", "3")

# Ревьюер читает, но не пишет и не собирает: сборка и тесты — шаг проверки.
REVIEWER_TOOLS = "Read,Grep,Glob,Skill,Bash(git diff:*),Bash(git log:*),Bash(git show:*),Bash(git status:*)"
REVIEWER_DENY = "Edit,Write,NotebookEdit"

IMPL_PROMPT = """{task}

Правила запуска:
- Следуй AGENTS.md проекта. Для изменения поведения сначала тест (skill test-driven-development).
- Не делай git commit / push, не трогай .env и opencode.json.
- Реализуй ровно задачу, без сопутствующих улучшений.
- В конце дай отчёт: что изменено (файлы), какие команды запускал и с каким результатом, что осталось недоделанным.
"""

REVIEW_PROMPT = """Ты независимый ревьюер. Загрузи skill `code-review-and-quality` через Skill tool и следуй ему.

Что нужно сделать (задача исполнителю):
{task}

Отчёт исполнителя (это его утверждения, а не доказательства — проверяй по коду):
{report}

Объём ревью: файл {diff} — diff относительно снимка дерева на начало работы. В нём только изменения
этой задачи; остальные правки в рабочем дереве к ней не относятся, игнорируй их. Сначала прочитай diff,
затем окружающий код, вызывающие места и тесты.

Правила:
- Только чтение. Ничего не правь, сборку и тесты не запускай — их гоняют отдельно.
- Каждая находка: id (F1, F2, ...), severity (blocker|major|minor|nit), file:line, в чём проблема,
  доказательство из кода, предлагаемое исправление. Без похвал и воды.
- Пиши по-русски.
- Последняя строка ответа строго `VERDICT: APPROVE` или `VERDICT: CHANGES_REQUESTED`.
  APPROVE — только если нет blocker и major.
"""

RESPOND_PROMPT = """Ниже независимое ревью твоей работы. Загрузи skill `receiving-code-review` и следуй ему:
проверь каждую находку по коду, классифицируй (valid / partially valid / invalid / needs clarification),
исправляй только валидные, невалидные отклоняй с доказательством. Без «отличное замечание» без правки за ним.
Не делай commit / push. После правок прогони точечные проверки по затронутому.
Закончи списком: id находки -> исправлено (файл) или отклонено (причина и доказательство).

{review}
"""

VALIDATE_PROMPT = """Ты независимый валидатор. Загрузи skill `code-review-and-quality` через Skill tool.

Исполнитель получил ревью и ответил на него. Проверь по коду, а не по его словам:
1. Каждая находка из ревью исправлена, либо отклонение обоснованно.
2. Исправления не внесли регрессий.

Ревью:
{review}

Ответ исполнителя:
{report}

Актуальный diff относительно начала работы: {diff}

Результат проверок проекта (`{check_cmd}`), код возврата {check_rc}:
{check_tail}

Правила: только чтение; пиши по-русски. Незакрытые пункты и новые проблемы — в том же формате
(id, severity, file:line, суть, доказательство, исправление). Если проверки красные, PASS невозможен.
Последняя строка строго `VERDICT: PASS` или `VERDICT: FAIL`.
"""


def log(msg):
    print(f"[dual-loop {time.strftime('%H:%M:%S')}] {msg}", file=sys.stderr, flush=True)


def git(*args, env=None):
    return subprocess.check_output(["git", *args], cwd=ROOT, text=True, env=env)


def snapshot_tree():
    """Хеш дерева текущего состояния (с неотслеживаемыми, без игнорируемых), рабочее дерево не трогаем."""
    with tempfile.TemporaryDirectory() as tmp:
        env = {**os.environ, "GIT_INDEX_FILE": str(Path(tmp) / "index")}
        git("add", "-A", env=env)
        return git("write-tree", env=env).strip()


def verdict(text, accept):
    m = re.findall(r"^\W*VERDICT:\s*([A-Z_]+)", text, re.M)
    return bool(m) and m[-1] == accept


def opencode(prompt, out_dir, tag, session=None, title=None):
    """Один ход opencode. Возвращает (session_id, финальный текст). Сырой поток — в <tag>.jsonl."""
    cmd = ["opencode", "run", "--auto", "--format", "json", "-m", IMPL_MODEL]
    if session:
        cmd += ["--session", session]
    if title:
        cmd += ["--title", title]
    cmd.append(prompt)

    head = git("rev-parse", "HEAD").strip()
    texts, seen = {}, set()
    sid = session
    with open(out_dir / f"{tag}.jsonl", "w") as raw:
        proc = subprocess.Popen(cmd, cwd=ROOT, stdout=subprocess.PIPE, text=True)
        for line in proc.stdout:
            raw.write(line)
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            sid = ev.get("sessionID", sid)
            part = ev.get("part", {})
            if ev.get("type") == "error":
                proc.kill()
                raise SystemExit(f"opencode: {ev['error'].get('message', ev['error'])}")
            if part.get("type") == "text":
                texts[part.get("messageID")] = part.get("text", "")
            elif part.get("type") == "tool" and part.get("id") not in seen:
                seen.add(part.get("id"))
                log(f"  opencode: {part.get('tool')}")
        proc.wait()
    # --auto одобряет всё, что явно не запрещено, поэтому «без commit» держим проверкой, а не доверием к промпту.
    if git("rev-parse", "HEAD").strip() != head:
        raise SystemExit("opencode сделал commit вопреки правилам запуска: останов, разберитесь вручную (git log)")
    if not texts:
        raise SystemExit("opencode не вернул текст ответа (см. сырой лог)")
    return sid, list(texts.values())[-1]


def claude(prompt, out_dir, tag):
    cmd = ["claude", "-p", "--model", REVIEW_MODEL, "--output-format", "json",
           "--permission-mode", "dontAsk", "--no-session-persistence",
           "--max-budget-usd", REVIEW_BUDGET_USD,
           f"--allowedTools={REVIEWER_TOOLS}", f"--disallowedTools={REVIEWER_DENY}"]
    res = subprocess.run(cmd, cwd=ROOT, input=prompt, capture_output=True, text=True)
    (out_dir / f"{tag}.raw.json").write_text(res.stdout)
    try:
        data = json.loads(res.stdout)
    except ValueError:
        raise SystemExit(f"claude: не JSON (rc={res.returncode}): {res.stderr[:500]}")
    if data.get("is_error") or not data.get("result"):
        raise SystemExit(f"claude: ошибка: {data.get('result') or res.stderr[:500]}")
    log(f"  claude: ${data.get('total_cost_usd', 0):.3f}")
    return data["result"]


def checks(out_dir, tag):
    log(f"проверки: {CHECK_CMD}")
    with open(out_dir / f"{tag}.log", "w") as f:
        rc = subprocess.run(CHECK_CMD, shell=True, cwd=ROOT, stdout=f, stderr=subprocess.STDOUT,
                            timeout=1800).returncode
    tail = "\n".join((out_dir / f"{tag}.log").read_text().splitlines()[-80:])
    return rc, tail


def write(out_dir, name, text):
    (out_dir / name).write_text(text)
    return text


def run(args):
    task = Path(args.file).read_text() if args.file else args.task
    if not task and not args.skip_impl:
        raise SystemExit("нужна задача: текстом или -f файл")
    task = task or "(реализация уже сделана, нужно только ревью текущего diff)"

    out_dir = RUNS / time.strftime("%Y%m%d-%H%M%S")
    out_dir.mkdir(parents=True)
    write(out_dir, "task.md", task)

    base = git("rev-parse", f"{args.base}^{{tree}}").strip() if args.base else snapshot_tree()
    session, report = None, "(исполнитель отчёта не давал)"

    if not args.skip_impl:
        log(f"реализация в opencode ({IMPL_MODEL})")
        session, report = opencode(IMPL_PROMPT.format(task=task), out_dir, "impl",
                                   title="dual-loop: " + task.strip().splitlines()[0][:60])
        write(out_dir, "impl.md", report)
        log(f"сессия opencode: {session}")

    def diff(tag):
        patch = git("diff", "--no-color", base, snapshot_tree())
        if not patch.strip():
            raise SystemExit("diff пуст: исполнитель ничего не изменил")
        (out_dir / f"{tag}.patch").write_text(patch)
        return out_dir / f"{tag}.patch"

    log(f"ревью ({REVIEW_MODEL})")
    review = write(out_dir, "review-1.md", claude(
        REVIEW_PROMPT.format(task=task, report=report, diff=diff("diff-0")), out_dir, "review-1"))

    passed = verdict(review, "APPROVE")
    if passed:
        log("ревьюер: APPROVE, правок нет")
        rc, tail = checks(out_dir, "checks-0")
        passed = rc == 0
        if not passed:
            review = f"Проверки проекта красные (код {rc}), хвост лога:\n{tail}"

    for rnd in range(1, args.rounds + 1):
        if passed:
            break
        log(f"раунд {rnd}/{args.rounds}: ответ на ревью в opencode")
        session, report = opencode(RESPOND_PROMPT.format(review=review), out_dir, f"respond-{rnd}",
                                   session=session, title="dual-loop: ревью")
        write(out_dir, f"respond-{rnd}.md", report)

        rc, tail = checks(out_dir, f"checks-{rnd}")
        log(f"валидация ({REVIEW_MODEL})")
        val = write(out_dir, f"validate-{rnd}.md", claude(
            VALIDATE_PROMPT.format(review=review, report=report, diff=diff(f"diff-{rnd}"),
                                   check_cmd=CHECK_CMD, check_rc=rc, check_tail=tail),
            out_dir, f"validate-{rnd}"))
        passed = rc == 0 and verdict(val, "PASS")
        if not passed:
            review = val if rc == 0 else f"{val}\n\nПроверки проекта красные (код {rc}):\n{tail}"

    status = "PASS" if passed else "НЕ ЗАКРЫТО — нужен человек"
    summary = (f"{status}\nartifacts: {out_dir}\n"
               f"opencode сессия: {session or '-'} (открыть: opencode -s {session})\n")
    write(out_dir, "summary.md", summary)
    print(summary)
    return 0 if passed else 1


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("run")
    r.add_argument("task", nargs="?", help="текст задачи")
    r.add_argument("-f", "--file", help="файл с задачей")
    r.add_argument("--rounds", type=int, default=2, help="максимум раундов ответа на ревью (по умолчанию 2)")
    r.add_argument("--skip-impl", action="store_true", help="пропустить реализацию: ревьюить текущий diff")
    r.add_argument("--base", help="ref, от которого считать diff (по умолчанию — снимок дерева на старте; "
                                  "с --skip-impl обычно HEAD)")
    r.set_defaults(fn=run)
    args = p.parse_args()
    sys.exit(args.fn(args))


if __name__ == "__main__":
    main()
