# Tasklerq — пример локальной конфигурации.
# Скопируйте в .env и заполните секреты; .env не коммитится.
# chmod 600 .env

# development | production
# Необязательно: по умолчанию `production` (HTTPS-адреса, без polling).
ENV=development
BIND_ADDR=0.0.0.0:8080
# Необязательно: публичный адрес инсталляции. Если задан в production,
# должен быть HTTPS.
PUBLIC_BASE_URL=http://127.0.0.1:18080

# Консоль администратора — отдельный listener.
# По умолчанию 0.0.0.0:8081 внутри контейнера; снаружи порт виден только после
# публикации в compose. `disabled` выключает консоль.
# Вне Docker или при network_mode: host задайте 127.0.0.1:8081.
ADMIN_BIND_ADDR=0.0.0.0:8081
# Сети CIDR через запятую, от которых консоль принимает X-Forwarded-*.
# Пусто — заголовкам не доверяем. Пример: 172.16.0.0/12
ADMIN_TRUSTED_PROXIES=

# Ключ шифрования секретов в базе: base64, ровно 32 байта.
# Сгенерируйте: openssl rand -base64 32
# Храните отдельно от резервных копий базы: без ключа сохранённые секреты
# придётся вводить заново. Пустое значение — ключ не задан.
TASKLERQ_SECRET_KEY=

# PostgreSQL (в docker compose dev используется сервис postgres)
DATABASE_URL=postgres://tasklerq:tasklerq@127.0.0.1:15433/tasklerq?sslmode=disable
DATABASE_MAX_CONNECTIONS=10

# Telegram — альтернатива консоли оператора (docs/deployment.md, раздел 5).
# Основной путь — страница «Telegram» в консоли: бот подключается и
# переключается без перезапуска. Переменные ниже действуют только вместе:
# окружение описывает бота целиком, только если задан TELEGRAM_BOT_TOKEN,
# и тогда перекрывает консоль целиком. Без токена TELEGRAM_* игнорируются с
# предупреждением в логе, а бот берётся из консоли (или выключен). Исключение:
# TELEGRAM_MODE=webhook или polling без токена — ошибка запуска.
# Для локальной разработки без бота оставьте весь блок закомментированным.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_MODE=webhook
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_WEBHOOK_URL=https://tasklerq.example.com/webhooks/telegram
# TELEGRAM_BOT_USERNAME=tasklerq_example_bot

# single | multi
# single — один household на инсталляцию (по умолчанию); multi — несколько.
TENANCY_MODE=single
# Telegram ID первого владельца. Рекомендуется при включённом Telegram:
# без него первым владельцем станет первый написавший боту.
BOOTSTRAP_OWNER_TELEGRAM_ID=

# LLM-capture: настройка в консоли администратора (docs/deployment.md, раздел 6).
# Переменные ниже — альтернатива консоли. Значение из окружения имеет приоритет
# и в консоли доступно только для чтения.
# Явный `LLM_CAPTURE_ENABLED=true` требует основного слота: адреса и модели.
# Если флаг не задан ни здесь, ни в консоли, а основной слот задан окружением,
# разбор включён — старые .env со слотами без флага продолжают работать.
# Слот считается заданным окружением при заданном `*_URL` или `*_MODEL`.
# LLM_CAPTURE_ENABLED=true
# LLM_PRIMARY_URL=https://openrouter.ai/api/v1
# LLM_PRIMARY_MODEL=anthropic/claude-haiku-5.5
# LLM_PRIMARY_TOKEN=
# LLM_PRIMARY_TIMEOUT_MS=10000
# LLM_PRIMARY_EXTRA_JSON=
# Резервный слот: адрес и модель задаются вместе или не задаются вовсе.
# LLM_FALLBACK_URL=http://192.168.1.10:8081/v1
# LLM_FALLBACK_MODEL=qwen3.8-4b
# LLM_FALLBACK_TOKEN=
# LLM_FALLBACK_TIMEOUT_MS=10000
# LLM_FALLBACK_EXTRA_JSON=
# LLM_CONNECT_TIMEOUT_MS=1000
# LLM_DAILY_QUOTA=200

# Внешний capture
CAPTURE_API_ENABLED=true
CAPTURE_VOICE_TIMEOUT_MS=8000
CAPTURE_VOICE_FALLBACK_RAW=true
CAPTURE_RATE_LIMIT_PER_MIN=10
CAPTURE_MAX_TEXT_CHARS=2000

# Очереди и retention
QUEUE_MAX_ATTEMPTS=10
QUEUE_READY_LAG_SECONDS=300
RETENTION_UPDATES_DAYS=7
RETENTION_DRAFTS_DAYS=30
RETENTION_LLM_RUNS_DAYS=90
RETENTION_EVENTS_DAYS=365
RETENTION_DELETED_DAYS=30
RETENTION_OUTBOX_DAYS=30
RETENTION_AUDIT_DAYS=365

# Логи
RUST_LOG=info,tasklerq=debug
TZ=UTC
