# Tasklerq — пример локальной конфигурации.
# Скопируйте в .env и заполните секреты; .env не коммитится.
# chmod 600 .env

# development | production
ENV=development
BIND_ADDR=0.0.0.0:8080
PUBLIC_BASE_URL=http://127.0.0.1:18080

# PostgreSQL (в docker compose dev используется сервис postgres)
DATABASE_URL=postgres://tasklerq:tasklerq@127.0.0.1:15433/tasklerq?sslmode=disable
DATABASE_MAX_CONNECTIONS=10

# webhook | polling | disabled
# Для локальной разработки удобен disabled: API и capture работают без бота.
TELEGRAM_MODE=disabled
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_BOT_USERNAME=tasklerq_example_bot

# single | multi
# single — один household на инсталляцию (по умолчанию); multi — несколько.
TENANCY_MODE=single
# Telegram ID первого владельца. Рекомендуется при включённом Telegram:
# без него первым владельцем станет первый написавший боту.
BOOTSTRAP_OWNER_TELEGRAM_ID=

# LLM-capture: прямой вызов OpenAI-совместимого API.
# Слоты и значения по умолчанию описаны в docs/deployment.md, раздел 6.
LLM_CAPTURE_ENABLED=false
LLM_PRIMARY_URL=
LLM_PRIMARY_MODEL=
LLM_PRIMARY_TOKEN=
LLM_PRIMARY_TIMEOUT_MS=10000
LLM_PRIMARY_EXTRA_JSON=
# Резервный слот: адрес и модель задаются вместе или не задаются вовсе.
# LLM_FALLBACK_URL=http://192.168.1.10:8081/v1
# LLM_FALLBACK_MODEL=qwen3.8-4b
# LLM_FALLBACK_TOKEN=
# LLM_FALLBACK_TIMEOUT_MS=10000
# LLM_FALLBACK_EXTRA_JSON=
LLM_CONNECT_TIMEOUT_MS=1000
LLM_DAILY_QUOTA=200

# Внешний capture
CAPTURE_API_ENABLED=true
CAPTURE_VOICE_TIMEOUT_MS=8000
CAPTURE_VOICE_FALLBACK_RAW=true
CAPTURE_RATE_LIMIT_PER_MIN=10
CAPTURE_MAX_TEXT_CHARS=2000

# Очереди и retention
QUEUE_MAX_ATTEMPTS=10
QUEUE_READY_LAG_SECONDS=300
RETENTION_UPDATES_DAYS=7
RETENTION_DRAFTS_DAYS=30
RETENTION_LLM_RUNS_DAYS=90
RETENTION_EVENTS_DAYS=365
RETENTION_DELETED_DAYS=30
RETENTION_OUTBOX_DAYS=30
RETENTION_AUDIT_DAYS=365

# Логи
RUST_LOG=info,tasklerq=debug
TZ=UTC
